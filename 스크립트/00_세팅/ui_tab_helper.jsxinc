// ui_tab_helper.jsxinc
// ScriptUI 탭 순서는 생성 순서라 `라벨(단위) | 입력창 | 스크롤바(‹ › 내장)` 행에서는 입력창 다음이
// 스크롤바로 간다. 창 안의 모든 입력창(edittext)을 생성 순서로 모아 탭(shift+탭)이
// 켜진 입력창끼리만 오가게 한다. 마지막에서는 처음으로 돌아간다.
// 사용: 창을 다 만든 뒤 win.show() 전에 bindTabOrder(win). 각 스크립트는 이 파일을
// $.evalFile로 읽고 typeof로 확인하므로, 파일이 없어도 스크립트는 그대로 동작한다.
function bindTabOrder(win) {
    if (win.__dialogInputsBound) return;
    win.__dialogInputsBound = true;
    var confirmButtons = [];
    collectDialogConfirmButtons(win, confirmButtons);
    compactDialog(win);
    try { addApplyButtons(win); } catch (applyError) {}
    stretchRowsOnShow(win);
    try { bindPanelFolds(win); } catch (foldError) {}
    var inputs = [];
    collectEditTexts(win, inputs);
    bindDeferredDialogInputs(win, inputs, confirmButtons);
    for (var k = 0; k < inputs.length; k++) {
        inputs[k].addEventListener("compositionstart", function() { this.__inputComposing = true; });
        inputs[k].addEventListener("compositionend", function() { this.__inputComposing = false; });
        inputs[k].addEventListener("keydown", makeTabOrderHandler(win, inputs, k));
    }
}

// 미리보기가 있는 창의 글 입력칸(옆에 슬라이더가 없는 입력칸) 줄 끝에 [완료]를 단다(2026-10-16).
// 이미 [완료](applyTo)가 있는 칸은 건드리지 않는다. 누르면 포커스 이동·Enter와 같은 경로(onChange)로 그 칸을 반영한다.
// 한 줄(같은 부모)에 입력칸이 여럿이면 단추 하나가 그 줄의 칸을 모두 반영한다(applyTo=마지막 칸, applyAlso=나머지).
// ScriptUI에는 moveAfter가 없어 단추는 항상 그 부모의 맨 끝에 붙는다(세로 부모는 입력칸이 맨 아래일 때만). 슬라이더 옆 숫자 칸과 창에 바로 붙은 입력칸은 달지 않는다.
// 끄려면 $.global.__noAutoApply = true.
function addApplyButtons(win) {
    if ($.global.__noAutoApply || !hasPreviewCheck(win)) return;
    var inputs = [], parents = [], groups = [], i, j;
    collectEditTexts(win, inputs);
    for (i = 0; i < inputs.length; i++) {
        var parent = inputs[i].parent;
        if (!parent || parent.type === "dialog" || parent.type === "window" || parent.type === "palette") continue;
        if (applyNotNeeded(parent, inputs[i])) continue;
        for (j = 0; j < parents.length; j++) if (parents[j] === parent) break;
        if (j === parents.length) { parents.push(parent); groups.push([]); }
        groups[j].push(inputs[i]);
    }
    for (i = 0; i < parents.length; i++) addApplyButton(parents[i], groups[i]);
}

function hasPreviewCheck(container) {
    var children = container.children;
    if (!children) return false;
    for (var i = 0; i < children.length; i++) {
        var child = children[i];
        if (child.type === "checkbox" && /미리보기/.test(child.text)) return true;
        if (hasPreviewCheck(child)) return true;
    }
    return false;
}

// 같은 줄에 슬라이더가 있거나 이미 그 칸을 확정하는 [완료]가 있으면 달지 않는다
function applyNotNeeded(parent, input) {
    var kids = parent.children;
    // 세로로 쌓는 부모에서는 단추가 맨 아래에 붙으므로 입력칸이 맨 아래일 때만 단다
    if (parent.orientation === "stack") return true;
    if (parent.orientation === "column" && kids[kids.length - 1] !== input) return true;
    for (var i = 0; i < kids.length; i++) {
        if (kids[i].type === "scrollbar") return true;
        if (kids[i].type !== "button" || !kids[i].applyTo) continue;
        if (kids[i].applyTo === input) return true;
        var also = kids[i].applyAlso || [];
        for (var j = 0; j < also.length; j++) if (also[j] === input) return true;
    }
    return false;
}

function addApplyButton(parent, inputs) {
    var button = parent.add("button", undefined, "완료");
    button.helpTip = "이 줄의 칸에 친 글을 반영합니다 (포커스 이동·Enter와 같음)";
    button.preferredSize.width = 50;
    button.preferredSize.height = COMPACT_ROW_HEIGHT;
    button.maximumSize.height = COMPACT_ROW_HEIGHT;
    button.applyTo = inputs[inputs.length - 1];
    button.applyAlso = inputs.slice(0, inputs.length - 1);
    button.onClick = function() {
        for (var i = 0; i < inputs.length; i++) if (inputs[i].onChange) inputs[i].onChange();
    };
}

function collectEditTexts(container, inputs) {
    var children = container.children;
    if (!children) return;
    for (var i = 0; i < children.length; i++) {
        var child = children[i];
        if (child.type === "edittext") inputs.push(child);
        else collectEditTexts(child, inputs);
    }
}

// 탭 선택 줄은 라디오 버튼이 기본이다. 라디오 줄이 너무 넓어 창 너비를 많이 잡아먹을 때만 드롭다운으로 바꾼다(2026-10-16).
// 라벨 글자 수로 폭을 어림한다(글자당 13px + 라디오 단추 30px + 간격 10px).
var TAB_RADIO_MAX_WIDTH = 600;
function tabSelectorNeedsDropdown(labels) {
    var width = 0;
    for (var i = 0; i < labels.length; i++) width += String(labels[i]).length * 13 + 30;
    width += Math.max(0, labels.length - 1) * 10;
    return width > TAB_RADIO_MAX_WIDTH;
}

function makeTabOrderHandler(win, inputs, index) {
    return function(event) {
        var input = inputs[index];
        if (input.__inputComposing || event.isComposing || event.keyCode === 229 || event.which === 229) return;
        var key = event.keyName || event.key;
        if (key === "Enter" || key === "Return" || event.keyCode === 13) {
            // IME 확정·여러 줄 줄바꿈을 가로채지 않는다. 기본 실행 버튼은 별도로 없앤다.
            // 네이티브 Enter가 onChange를 주지 않는 환경(Windows)이 있어, 바뀐 글이 있으면 입력칸의 반영 함수(enterApply)를 부른다.
            if (input.properties && input.properties.multiline) return;
            if (input.enterApply) input.enterApply();
            try { event.preventDefault(); } catch (enterError) {}
            return;
        }
        if (event.keyName !== "Tab") return;
        var step = event.shiftKey ? -1 : 1;
        var count = inputs.length;
        for (var n = 1; n < count; n++) {
            var next = inputs[((index + step * n) % count + count) % count];
            if (!isTabTarget(win, next)) continue;
            next.active = true;
            try { event.preventDefault(); } catch (e) {}
            return;
        }
    };
}

// 문구 덮어쓰기를 적용하기 전에 완료 버튼을 식별한다. 취소·닫기·R은 확정 버튼이 아니다.
function collectDialogConfirmButtons(container, buttons) {
    var children = container.children;
    if (!children) return;
    for (var i = 0; i < children.length; i++) {
        var child = children[i];
        // 입력칸 옆 [완료](applyTo)는 그 칸만 확정하는 단추라 창 확인 단추가 아니다
        if (child.type === "button" && !child.applyTo &&
            ((child.properties && child.properties.name === "ok") ||
            /^(확인|완료|완료하기|적용|실행|만들기|그리기|OK)$/.test(child.text))) buttons.push(child);
        else collectDialogConfirmButtons(child, buttons);
    }
}

// 글자를 칠 때마다(onChanging) 다시 그리지 않는다. 포커스를 옮기거나 Enter를 칠 때(onChange) 기존 처리기로 반영하고,
// 반영한 글은 확정값으로 기억한다(2026-10-14). 입력칸 옆 [완료]처럼 applyTo(입력창)가 붙은 단추는 그 입력칸을 확정한다.
// 확인 때는 아직 반영되지 않은 입력을 기존 onChange 검증·반영 경로로 한 번 더 반영한다.
// 다른 옵션은 확정된 입력으로 미리보기하고, 아직 반영되지 않은 원문은 그 뒤에 되돌려 놓는다.
function bindDeferredDialogInputs(win, inputs, confirmButtons) {
    if (!inputs.length || !confirmButtons.length) return;
    try { win.defaultElement = null; } catch (defaultError) {}
    var state = {applying: false, confirming: false}, fields = [];
    for (var i = 0; i < inputs.length; i++) {
        var input = inputs[i];
        var field = {input: input, text: String(input.text), touched: false,
            change: input.onChange, changing: input.onChanging};
        fields.push(field);
        input.onChange = makeDeferredInputHandler(state, field, field.change || field.changing, true);
        input.onChanging = makeDeferredInputHandler(state, field, field.changing, false);
        input.enterApply = makeEnterApply(field);
    }
    function flush() {
        // 한 필드의 검증이 다른 입력창을 정규화해도 입력 중인 원문을 잃지 않도록 먼저 읽는다.
        var values = [], dirty = [], j;
        for (j = 0; j < fields.length; j++) {
            values[j] = String(fields[j].input.text);
            dirty[j] = values[j] !== fields[j].text && isDialogConfirmTarget(win, fields[j].input);
        }
        state.applying = true;
        try {
            for (j = 0; j < fields.length; j++) {
                if (!dirty[j]) continue;
                fields[j].input.text = values[j];
                fields[j].input.onChange();
            }
            for (j = 0; j < fields.length; j++) fields[j].text = String(fields[j].input.text);
        } finally { state.applying = false; }
    }
    function wrapControl(handler, confirm, applyTargets) {
        return function() {
            if (state.applying) return handler ? handler.apply(this, arguments) : undefined;
            if (confirm) {
                if (state.confirming) return;
                state.confirming = true;
                try {
                    flush();
                    state.applying = true;
                    return handler ? handler.apply(this, arguments) : win.close(1);
                } finally { state.applying = false; state.confirming = false; }
            }
            var pending = [], j;
            for (j = 0; j < fields.length; j++) {
                pending[j] = String(fields[j].input.text);
                fields[j].touched = false;
                // [완료]가 확정하는 입력칸은 친 글 그대로 둔다
                if (!isApplyTarget(fields[j].input, applyTargets)) fields[j].input.text = fields[j].text;
            }
            state.applying = true;
            try { return handler.apply(this, arguments); }
            finally {
                for (j = 0; j < fields.length; j++) {
                    var current = String(fields[j].input.text);
                    if (current !== fields[j].text || fields[j].touched) fields[j].text = current;
                    else fields[j].input.text = pending[j];
                }
                state.applying = false;
            }
        };
    }
    function walk(container) {
        var children = container.children;
        if (!children) return;
        for (var j = 0; j < children.length; j++) {
            var child = children[j], confirm = false;
            for (var k = 0; k < confirmButtons.length; k++) if (child === confirmButtons[k]) confirm = true;
            if (child.type !== "edittext") {
                if (confirm || child.onClick) child.onClick = wrapControl(child.onClick, confirm, child.applyTo ? [child.applyTo].concat(child.applyAlso || []) : null);
                if (child.onChange) child.onChange = wrapControl(child.onChange, false);
                if (child.onChanging) child.onChanging = wrapControl(child.onChanging, false);
            }
            walk(child);
        }
    }
    walk(win);
    var show = win.onShow;
    win.onShow = function() {
        if (show) show.apply(this, arguments);
        for (var j = 0; j < fields.length; j++) fields[j].text = String(fields[j].input.text);
    };
}

function isApplyTarget(input, targets) {
    if (!targets) return false;
    for (var i = 0; i < targets.length; i++) if (targets[i] === input) return true;
    return false;
}

// Enter를 쳤을 때 아직 반영하지 않은 글이 있으면 포커스 이동과 같은 경로(onChange)로 반영한다. 여러 줄 칸은 건드리지 않는다
function makeEnterApply(field) {
    return function() {
        var input = field.input;
        try { if (input.properties && input.properties.multiline) return; } catch (e) {}
        if (String(input.text) !== field.text) input.onChange();
    };
}

// live: 포커스 이동·Enter(onChange)면 바로 반영, 글자마다 오는 onChanging은 확정 때만
function makeDeferredInputHandler(state, field, handler, live) {
    return function() {
        if (state.applying) {
            field.touched = true;
            return handler ? handler.apply(this, arguments) : undefined;
        }
        if (!live || !handler || field.input.__inputComposing) return;
        if (String(field.input.text) === field.text) return;
        var result = handler.apply(this, arguments);
        field.text = String(field.input.text);
        return result;
    };
}

// 자신이나 조상(패널·그룹)이 꺼져 있거나 숨겨진 입력창은 건너뛴다
function isTabTarget(win, control) {
    for (var c = control; c && c !== win; c = c.parent) {
        if (!c.enabled || !c.visible) return false;
    }
    return true;
}

// 접어서만 숨겨진 입력은 확인할 때 확정한다. 비활성 탭·원래 숨긴 항목은 계속 제외한다.
function isDialogConfirmTarget(win, control) {
    for (var c = control; c && c !== win; c = c.parent) {
        if (!c.enabled) return false;
        if (!c.visible) {
            var state = c.parent && c.parent.__foldState, restored = false;
            if (state && state.collapsed) {
                for (var i = 0; i < state.items.length; i++) {
                    if (state.items[i].control === c) restored = state.items[i].visible;
                }
            }
            if (!restored) return false;
        }
    }
    return true;
}

// ---- 대화상자 다이어트 (bindTabOrder가 창을 띄우기 직전에 부른다) ----
// 스크립트마다 손대지 않고 한 곳에서 줄인다. 줄이기만 하고 늘리지는 않는다.
//  - 창·패널 여백, 그룹 간격
//  - 스크롤바 폭 118 이하 (R 버튼은 그대로)
//  - 라벨의 "(단위)"·콜론 제거 (단위는 마우스를 올리면 툴팁으로), 라벨 칸을 글자 폭에 맞춤
//  - 확인·취소 버튼 폭 고정, 버튼만 있는 줄은 오른쪽 정렬
// 검증용으로 $.global.__noCompact = true면 건너뛴다. 실패해도 대화상자는 그대로 뜬다.
var COMPACT_SLIDER_WIDTH = 118;
var COMPACT_BUTTON_WIDTH = 64;
var COMPACT_BUTTON_PAD = 14;   // 글자 좌우 여백 합 (2026-10-09: 28 → 14로 절반)
var COMPACT_ROW_HEIGHT = 22;
var COMPACT_CHECK_BOX = 20;   // 체크박스의 네모와 글자 사이까지 폭 (숫자 행 첫 칸이 체크박스일 때)
var COMPACT_UNIT = /^(mm|cm|m|pt|px|%|°|deg|s|ms|배|개|회|번|도|단계|줄|칸|N|J|g|kg|K|℃|°C|m\/s|m\/s²)$/;
var COMPACT_BUTTONS = {"확인": true, "취소": true, "OK": true, "Cancel": true, "적용": true, "닫기": true};

function compactDialog(win) {
    try {
        if ($.global.__noCompact) return;
        try {
            var wm = win.margins;
            win.margins = [Math.min(wm[0], 8), Math.min(wm[1], 8), Math.min(wm[2], 8), Math.min(wm[3], 8)];
            if (win.spacing > 3) win.spacing = 3;
        } catch (e0) {}
        compactWalk(win);
        compactButtons(win);
        compactAlignRows(win);
        compactArrowheadNames(win);
    } catch (e) {}
    // 로컬 서버(tools/ui-admin.js)로 고친 제목·슬라이더 범위·기본값·항목 문구를 적용하고, 화면 요소 목록을 남긴다
    try { uiCatalogAndOverrides(win); } catch (e2) {}
}

function compactWalk(container) {
    var children = container.children;
    if (!children) return;
    var i, child;
    for (i = 0; i < children.length; i++) {
        child = children[i];
        try {
            if (child.type === "panel") {
                compactPanelTitle(child);
                var m = child.margins;
                child.margins = [Math.min(m[0], 8), Math.max(12, Math.min(m[1], 14)), Math.min(m[2], 8), Math.min(m[3], 3)];
                if (child.spacing > 1) child.spacing = 1;
            } else if (child.type === "group") {
                var limit = child.orientation === "row" ? 6 : 1;
                if (child.spacing > limit) child.spacing = limit;
            } else if (child.type === "scrollbar") {
                // 이미 레이아웃이 잡힌 창은 preferredSize만으로는 줄지 않아 maximumSize도 건다
                if (child.preferredSize.width > COMPACT_SLIDER_WIDTH) {
                    child.preferredSize.width = COMPACT_SLIDER_WIDTH;
                    child.maximumSize.width = COMPACT_SLIDER_WIDTH;
                }
            } else if (child.type === "statictext") {
                compactLabel(child);
            } else if (child.type === "edittext") {
                // 한 줄짜리 입력창은 기본 높이가 커서 행이 높아진다
                if (!child.properties || !child.properties.multiline) { child.preferredSize.height = COMPACT_ROW_HEIGHT; child.maximumSize.height = COMPACT_ROW_HEIGHT; }
            } else if (child.type === "dropdownlist") {
                child.preferredSize.height = COMPACT_ROW_HEIGHT;
                child.maximumSize.height = COMPACT_ROW_HEIGHT;
            } else if (child.type === "button" && child.text === "R") {
                child.preferredSize.height = COMPACT_ROW_HEIGHT;
                child.maximumSize.height = COMPACT_ROW_HEIGHT;
            } else if (child.type === "button" && COMPACT_BUTTONS[child.text]) {
                child.preferredSize.width = COMPACT_BUTTON_WIDTH;
                child.maximumSize.width = COMPACT_BUTTON_WIDTH;
            }
        } catch (e1) {}
        if (child.children && child.children.length) compactWalk(child);
    }
    try { compactLabelWidths(container); } catch (e2) {}
    try { compactButtonRow(container); } catch (e3) {}
}

// "크기 (mm):" → "크기" (단위는 툴팁), "각도:" → "각도". 긴 안내문은 건드리지 않는다
function compactLabel(label) {
    var text = label.text;
    if (!text || text.length > 30) return;
    var unit = text.match(/^(.*\S)\s*\(([^)]+)\)\s*[:：]?\s*$/);
    if (unit && COMPACT_UNIT.test(unit[2])) {
        label.text = unit[1];
        if (!label.helpTip) label.helpTip = unit[2];
        return;
    }
    var colon = text.match(/^(.*\S)\s*[:：]\s*$/);
    if (colon) label.text = colon[1];
}

// 같은 컨테이너의 행(그룹)마다 첫 라벨 폭을 가장 긴 글자에 맞춰 줄인다 (원래 폭보다 늘리지는 않는다)
function compactLabelWidths(container) {
    var rows = [], i, need = 0;
    for (i = 0; i < container.children.length; i++) {
        var g = container.children[i];
        if (g.type !== "group" || g.children.length < 2) continue;
        var first = g.children[0];
        if (first.type !== "statictext" || !(first.preferredSize.width > 0)) continue;
        rows.push(first);
        var w = first.graphics.measureString(first.text)[0];
        if (w > need) need = w;
    }
    var width = Math.ceil(need) + 6;
    for (i = 0; i < rows.length; i++) {
        if (width < rows[i].preferredSize.width) {
            rows[i].preferredSize.width = width;
            rows[i].maximumSize.width = width;
        }
    }
}

// 확인·취소만 있는 줄은 오른쪽에 붙인다 (다른 컨트롤이 같이 있으면 정렬은 그대로)
function compactButtonRow(container) {
    if (container.type !== "group") return;
    var any = false, i;
    for (i = 0; i < container.children.length; i++) {
        var c = container.children[i];
        if (c.type === "button" && COMPACT_BUTTONS[c.text]) any = true;
        else if (!(c.type === "group" && c.children.length === 0)) return;
    }
    if (any) container.alignment = ["right", "center"];
}

// 패널 제목이 길면 첫 문장만 남기고 나머지는 툴팁으로 ("관찰 각도 방식. 선택 없이…" → "관찰 각도 방식")
function compactPanelTitle(panel) {
    var text = panel.text;
    if (!text || text.length <= 12) return;
    var cut = text.search(/\. |\s—\s|\s\(/);
    if (cut < 2) return;
    if (!panel.helpTip) panel.helpTip = text;
    panel.text = text.substr(0, cut);
}

// 글자보다 훨씬 넓게 지정된 버튼(프리셋 줄 등)을 글자 폭에 맞춘다. 폭이 따로 지정된 버튼 중 글자 폭 + 12보다 넓은 것만 줄이고,
// 한 줄(그룹)의 버튼은 가장 긴 글자에 맞춰 같은 폭으로 한다 (R 버튼·격자처럼 원래 좁은 버튼은 그대로).
// 주의: 여기서 layout()을 부르면 안 된다. 한 번 레이아웃이 잡히면 ScriptUI가 늘어난 크기를 preferredSize로 굳혀 이후에 줄여도 창이 줄지 않는다.
function compactButtons(win) {
    compactButtonWalk(win);
}

function compactButtonWalk(container) {
    var i, k, group = [], need = 0, wide = false;
    for (i = 0; i < container.children.length; i++) {
        k = container.children[i];
        if (k.type === "button" && k.text && k.text !== "R" && !COMPACT_BUTTONS[k.text]) {
            var w = k.graphics.measureString(k.text)[0] + COMPACT_BUTTON_PAD;
            group.push(k);
            if (w > need) need = w;
            if (k.preferredSize.width > w + 12) wide = true;
        }
        if (k.children && k.children.length) compactButtonWalk(k);
    }
    if (!wide) return;
    for (i = 0; i < group.length; i++) {
        if (group[i].preferredSize.width > need) {
            group[i].preferredSize.width = Math.ceil(need);
            group[i].maximumSize.width = Math.ceil(need);
        }
    }
}

// ---- 접는 패널 ----
// 기존 호출의 body·children 경로는 유지한다. 접기 표시는 기본 제목 문자열 오른쪽에 붙여 별도 행을 차지하지 않는다.
// (parent.add("panel") 대신 body = makeCollapsiblePanel(parent, "제목", true, "스크립트/패널") 으로 만들고 body.add(...)).
// 접힌 상태는 app.preferences "<key>"(1 = 접힘)에 기억한다. 헬퍼가 없는 환경에서는 일반 패널로 대신해도 된다:
//   var body = typeof makeCollapsiblePanel === "function" ? makeCollapsiblePanel(...) : parent.add("panel", undefined, "제목");
// 숨기는 건 visible이 아니라 maximumSize.height = 0이다 (visible=false는 공간을 비우지 않는다).
function makeCollapsiblePanel(parent, title, collapsedDefault, key) {
    var collapsed = collapsedDefault;
    try {
        var saved = app.preferences.getStringPreference("Fold/" + key);
        if (saved === "1") collapsed = true;
        else if (saved === "0") collapsed = false;
    } catch (e0) {}
    var panel = parent.add("panel", undefined, title);
    panel.orientation = "column";
    panel.alignChildren = "fill";
    var head = panel.add("group");
    head.alignChildren = ["left", "center"];
    var toggle = head.add("button", undefined, "");
    // 기존 UI 관리 경로를 보존하기 위해 예전 헤더·단추는 높이 0으로 남긴다.
    head.visible = false;
    head.preferredSize.height = head.maximumSize.height = 0;
    toggle.visible = false;
    toggle.preferredSize.height = toggle.maximumSize.height = 0;
    var body = panel.add("group");
    body.orientation = "column";
    body.alignChildren = "fill";
    toggle.text = collapsed ? "펼치기" : "접기";
    panel.__foldKey = "Fold/" + key;
    panel.__foldDefault = collapsed;
    body.panel = panel;
    return body;
}

// 제목 있는 모든 옵션 패널에 적용한다. 요소를 추가·이동하지 않아 UI 덮어쓰기 경로를 보존한다.
function bindPanelFolds(win) {
    if (win.__panelFoldsBound || $.global.__noPanelFolds) return;
    win.__panelFoldsBound = true;
    var panels = [];
    function walk(parent, path) {
        if (!parent.children) return;
        for (var i = 0; i < parent.children.length; i++) {
            var c = parent.children[i], childPath = path + "/" + i;
            if (c.type === "panel" && c.text && c.children.length) {
                var key = c.__foldKey || "Fold/Auto/" + win.text + childPath;
                var collapsed = c.__foldDefault === true;
                try {
                    var saved = app.preferences.getStringPreference(key);
                    if (saved === "1" || saved === "0") collapsed = saved === "1";
                } catch (readError) {}
                c.__foldState = {key: key, collapsed: false, initial: collapsed, items: [], win: win};
                bindPanelFoldHeader(c);
                panels.push(c);
            }
            walk(c, childPath);
        }
    }
    walk(win, "");
    if (!panels.length) return;
    win.__foldPanels = panels;
    bindFoldPageResize(win);
    var show = win.onShow;
    win.onShow = function() {
        // 폭은 모두 펼친 상태에서 확보한다. 접힌 상태로 다시 열어도 제목·숫자 행이 잘리지 않는다.
        var width = win.size.width;
        for (var i = panels.length - 1; i >= 0; i--) {
            var p = panels[i];
            p.minimumSize.width = Math.max(p.minimumSize.width, p.size.width);
            if (p.visible) {
                p.__foldState.initialApplied = true;
                if (p.__foldState.initial) setPanelFold(p, true);
            }
        }
        // 다른 페이지를 숨기기 전에 자식의 원래 visible 값을 보관해야 펼칠 때 복원된다.
        if (show) show.apply(this, arguments);
        win.minimumSize.width = Math.max(win.minimumSize.width, width);
        resizeFoldDialog(win);
    };
}

function bindPanelFoldHeader(panel) {
    // 패널 onDraw를 바꾸면 내부 그룹의 네이티브 컨트롤이 사라진다.
    // 제목 자체에 아이콘을 붙여 기본 패널·자식 렌더링을 그대로 사용한다.
    panel.__foldTitle = panel.text;
    updatePanelFoldTitle(panel);
    panel.helpTip = (panel.helpTip ? panel.helpTip + "\n" : "") + "제목 줄을 클릭하면 접기·펼치기 (삼각형 아이콘)";
    panel.addEventListener("mousedown", function(event) {
        if (event.target !== panel || event.clientY > 18 || event.clientY < 0) return;
        if (event.button !== undefined && event.button !== 0) return;
        setPanelFold(panel, !panel.__foldState.collapsed, true);
        if (event.preventDefault) event.preventDefault();
    });
}

function updatePanelFoldTitle(panel) {
    panel.text = panel.__foldTitle + (panel.__foldState.collapsed ? "   \u25B6" : "   \u25BC");
}

function setPanelFold(panel, collapsed, save) {
    var state = panel.__foldState;
    if (!state || state.collapsed === collapsed) return;
    var i, item, c;
    if (collapsed) {
        state.items = [];
        state.minimum = panel.minimumSize.height;
        state.maximum = panel.maximumSize.height;
        state.preferred = panel.preferredSize.height;
        for (i = 0; i < panel.children.length; i++) {
            c = panel.children[i];
            state.items.push({control: c, visible: c.visible, minimum: c.minimumSize.height,
                maximum: c.maximumSize.height, preferred: c.preferredSize.height});
            c.minimumSize.height = 0;
            c.preferredSize.height = c.maximumSize.height = 0;
            c.visible = false;
        }
        panel.minimumSize.height = 0;
        panel.preferredSize.height = panel.maximumSize.height = 22;
        panel.minimumSize.height = 22;
    } else {
        panel.maximumSize.height = state.maximum;
        panel.minimumSize.height = state.minimum;
        panel.preferredSize.height = state.preferred;
        for (i = 0; i < state.items.length; i++) {
            item = state.items[i]; c = item.control;
            c.maximumSize.height = item.maximum;
            c.minimumSize.height = item.minimum;
            c.preferredSize.height = item.preferred;
            c.visible = item.visible;
        }
    }
    state.collapsed = collapsed;
    updatePanelFoldTitle(panel);
    if (save) {
        try { app.preferences.setStringPreference(state.key, collapsed ? "1" : "0"); } catch (writeError) {}
        resizeFoldDialog(state.win);
    }
}

function resizeFoldDialog(win) {
    if (win.__foldResizing) return;
    win.__foldResizing = true;
    try {
        var panels = win.__foldPanels || [];
        for (var i = 0; i < panels.length; i++) {
            var panel = panels[i], state = panel.__foldState;
            // 기본 탭의 비활성 페이지는 처음부터 숨겨져 있으므로 처음 선택한 뒤 상태를 적용한다.
            if (!state.initialApplied && panel.visible) {
                state.initialApplied = true;
                if (state.initial) setPanelFold(panel, true);
            }
        }
        syncFoldPageHeights(win);
        win.size = [win.size.width, 10];
        win.layout.layout(true);
    } catch (layoutError) {}
    finally { win.__foldResizing = false; }
}

// stack의 숨긴 페이지도 기본 레이아웃은 높이에 포함한다. 숨긴 페이지의 높이만 0으로 제한한다.
// 패널 내부 요소·탭 순서·페이지 너비는 건드리지 않는다.
function bindFoldPageResize(win) {
    var stacks = [];
    function collect(c) {
        if (!c.children) return;
        if (c.type === "tabbedpanel") stacks.push(c);
        else if (c.type === "group" && c.orientation === "stack" && c.children.length > 1) {
            var pagesOnly = true;
            for (var j = 0; j < c.children.length; j++) {
                if (c.children[j].type !== "group") pagesOnly = false;
            }
            if (pagesOnly) stacks.push(c);
        }
        for (var i = 0; i < c.children.length; i++) collect(c.children[i]);
    }
    collect(win);
    win.__foldStacks = stacks;
    if (!stacks.length) return;
    function visibilityKey() {
        var key = "";
        for (var i = 0; i < stacks.length; i++) {
            for (var j = 0; j < stacks[i].children.length; j++) key += isFoldPageShown(stacks[i], stacks[i].children[j]) ? "1" : "0";
        }
        return key;
    }
    function wrap(handler, always) {
        return function() {
            var before = visibilityKey();
            var result = handler.apply(this, arguments);
            if (always || before !== visibilityKey()) resizeFoldDialog(win);
            return result;
        };
    }
    function bind(c) {
        if (c.type === "radiobutton" || c.type === "dropdownlist" || c.type === "button" || c.type === "tabbedpanel") {
            if (c.onClick) c.onClick = wrap(c.onClick);
            if (c.onChange || c.type === "tabbedpanel") c.onChange = wrap(c.onChange || function() {}, c.type === "tabbedpanel");
        }
        if (c.children) for (var i = 0; i < c.children.length; i++) bind(c.children[i]);
    }
    bind(win);
}

function isFoldPageShown(stack, page) {
    return stack.type === "tabbedpanel" ? stack.selection === page : page.visible;
}

function syncFoldPageHeights(win) {
    var stacks = win.__foldStacks || [];
    for (var i = 0; i < stacks.length; i++) {
        var stack = stacks[i];
        for (var j = 0; j < stack.children.length; j++) {
            var page = stack.children[j], saved = page.__foldPageHeight;
            if (!isFoldPageShown(stack, page) && !saved) {
                page.__foldPageHeight = {minimum: page.minimumSize.height,
                    maximum: page.maximumSize.height, preferred: page.preferredSize.height};
                page.minimumSize.height = 0;
                page.preferredSize.height = page.maximumSize.height = 0;
            } else if (isFoldPageShown(stack, page) && saved) {
                page.maximumSize.height = saved.maximum;
                page.minimumSize.height = saved.minimum;
                page.preferredSize.height = saved.preferred;
                page.__foldPageHeight = null;
            }
        }
        // stack 자체에 직전 페이지 높이가 남지 않도록 다시 계산한다.
        stack.preferredSize.height = -1;
    }
}

// ---- 좌우 여백 맞추기 (bindTabOrder가 부른다, 2026-10-14) ----
// 창 폭은 가장 넓은 줄(겹쳐 쌓은 탭 페이지는 가장 넓은 페이지)이 정해서, 좁은 줄은 오른쪽이 빈다.
// 창이 뜬 뒤(크기를 잴 수 있을 때) 숫자 행의 스크롤바, 넓게 지정한 입력칸·안내문, 아래 줄의 가운데 빈칸을
// 들어 있는 패널의 안쪽 오른쪽 끝까지 늘린다. 늘리기만 하고 창 폭은 바꾸지 않는다.
//  - 레이아웃이 한 번 잡힌 뒤에는 preferredSize로 늘어나지 않아 minimumSize를 건다. 최소폭이 최대폭에 잘리므로 최대폭을 먼저 늘린다.
//  - 패널은 margins보다 오른쪽을 조금 더 남긴다(Mac 4pt). 패널을 채우는 높이 0 그룹을 하나 넣어 그 값을 잰다.
//  - 가로로 나란히 놓인 줄(부모가 row)은 늘리면 옆 줄을 밀어내므로 건드리지 않는다.
var STRETCH_WIDE_TEXT = 200;

function stretchRowsOnShow(win) {
    if ($.global.__noCompact) return;
    var targets = [], probes = {};
    try {
        collectStretchTargets(win, targets);
        if (!targets.length) return;
        addStretchProbe(win, "panel", probes);
        addStretchProbe(win, "tab", probes);
    } catch (e0) { return; }
    var previous = win.onShow;
    win.onShow = function() {
        try {
            if (stretchToRightEdge(targets, probes)) win.layout.layout(true);
        } catch (e1) {}
        if (previous) return previous.apply(this, arguments);
    };
}

function collectStretchTargets(container, targets) {
    var children = container.children;
    if (!children) return;
    var column = container.orientation !== "row";
    for (var i = 0; i < children.length; i++) {
        var child = children[i], kids = child.children;
        if (child.type === "group" && kids && kids.length >= 4 && (kids[0].type === "statictext" || kids[0].type === "checkbox") && kids[1].type === "edittext" && kids[2].type === "scrollbar") {
            if (column) addStretchTarget(targets, child, kids[2]);
        } else if ((child.type === "edittext" || child.type === "statictext") && child.preferredSize.width >= STRETCH_WIDE_TEXT) {
            if (container.type === "group" && !column) {
                if (container.parent && container.parent.orientation !== "row") addStretchTarget(targets, container, child);
            } else if (column) {
                addStretchTarget(targets, child, child);
            }
        } else if (child.type === "group" && kids && kids.length === 0 && !column && stretchFills(child)) {
            if (container.parent && container.parent.orientation !== "row") addStretchTarget(targets, container, child);
        } else if (kids && kids.length) {
            collectStretchTargets(child, targets);
        }
    }
}

function addStretchTarget(targets, host, item) {
    for (var i = 0; i < targets.length; i++) if (targets[i].host === host) return;
    targets.push({host: host, item: item});
}

function stretchFills(element) {
    try {
        var a = element.alignment;
        return a === "fill" || (a && a[0] === "fill");
    } catch (e) { return false; }
}

// type("panel"/"tab")인 첫 컨테이너 끝에 폭을 채우는 높이 0 그룹을 둔다. 창이 뜬 뒤 그 오른쪽 끝이 패널 안쪽 끝이다.
// 맨 끝에 붙이므로 기존 요소의 순번(대화상자 요소 편집의 경로)은 바뀌지 않는다
function addStretchProbe(container, type, probes) {
    var children = container.children;
    if (!children || probes[type]) return;
    for (var i = 0; i < children.length && !probes[type]; i++) {
        var child = children[i];
        if (child.type === type) {
            var probe = child.add("group");
            probe.alignment = ["fill", "top"];
            probe.maximumSize.height = 0;
            probes[type] = {container: child, group: probe};
        } else if (child.children && child.children.length) {
            addStretchProbe(child, type, probes);
        }
    }
}

function stretchToRightEdge(targets, probes) {
    var extra = {panel: 0, tab: 0}, changed = false, key;
    for (key in probes) {
        var p = probes[key];
        var measured = p.container.size.width - p.container.margins[2] - p.group.bounds.right;
        if (measured >= 0 && measured < 20) extra[key] = measured;
    }
    for (var i = 0; i < targets.length; i++) {
        var host = targets[i].host, item = targets[i].item, parent = host.parent;
        var limit = parent.size.width - parent.margins[2] - (extra[parent.type] || 0);
        // 패널 밖에서 왼쪽을 줄 여백으로 패널 안 줄에 맞춘 줄(compactAlignRows)은 오른쪽도 패널 안 줄과 같은 자리에서 끝낸다.
        // 패널 안에서 더 깊은 줄과 열을 맞추느라 생긴 작은 왼쪽 여백은 오른쪽에 옮기지 않는다
        var inPanel = parent.type === "panel" || parent.type === "tab";
        if (host !== item && host.margins[0] > 0 && !inPanel) limit -= host.margins[0] + extra.panel;
        // 줄이 창 폭을 다 차지해도 내용은 왼쪽에 모여 있으므로 마지막 요소의 오른쪽 끝을 잰다
        var right = host === item ? host.bounds.right : host.bounds.left + host.children[host.children.length - 1].bounds.right;
        var free = limit - right;
        if (!(free > 0.5 && free < parent.size.width)) continue;
        var width = item.size.width + free;
        item.maximumSize.width = width;
        item.minimumSize.width = width;
        item.preferredSize.width = width;
        changed = true;
    }
    return changed;
}

// ---- 화면 요소 목록(카탈로그)과 덮어쓰기 ----
// 창이 뜨기 직전에 창 안의 요소를 훑어 00_세팅/ui_catalog/<창 제목>.json에 목록을 남기고(바뀐 때만),
// 00_세팅/ui_overrides.json에 있는 덮어쓰기를 적용한다. 편집은 tools/ui-admin.js(로컬 서버)로 한다.
// 요소는 창에서 시작하는 children 순번 경로(id, 예 "1/0/2")로 가리키고, 덮어쓰기에는 고칠 때의 원래 값(orig)이 같이 저장되어
// 스크립트가 바뀌어 순번이 달라지면 orig가 어긋나 적용하지 않는다.
// 덮어쓸 수 있는 것: 제목·단추·체크·라디오 글자, 패널 제목, 드롭다운 항목 문구(개수·순서는 그대로),
// 스크롤바 최솟값·최댓값·단계, R 단추가 되돌리는 값(reset).
// 한계: 스크립트가 글자로 항목을 구분하면(selection.text 비교) 문구를 바꾸었을 때 동작이 달라질 수 있다.
//       입력창이 받는 값의 한계(스크립트 안의 상수)는 바뀌지 않고 스크롤바 범위만 바뀐다.
var UI_HELPER_DIR = (function() { try { return new File($.fileName).parent.fsName; } catch (e) { return ""; } })();

function uiJson(v) {
    var t = typeof v, i, out;
    if (v === null || v === undefined) return "null";
    if (t === "number") return isFinite(v) ? String(v) : "null";
    if (t === "boolean") return v ? "true" : "false";
    if (t === "string") {
        return '"' + v.replace(/\\/g, "\\\\").replace(/"/g, '\\"').replace(/\r/g, "\\r").replace(/\n/g, "\\n").replace(/\t/g, "\\t") + '"';
    }
    if (v instanceof Array) {
        out = [];
        for (i = 0; i < v.length; i++) out.push(uiJson(v[i]));
        return "[" + out.join(",") + "]";
    }
    out = [];
    for (var k in v) if (v.hasOwnProperty(k)) out.push(uiJson(k) + ":" + uiJson(v[k]));
    return "{" + out.join(",") + "}";
}

function uiReadFile(path) {
    var f = new File(path);
    if (!f.exists) return null;
    f.encoding = "UTF-8";
    f.open("r");
    var t = f.read();
    f.close();
    return t;
}

// 로마 숫자(Ⅰ Ⅱ)도 남긴다. 빼면 "수학Ⅰ"과 "수학Ⅱ"가 같은 파일(수학.json)에 겹쳐 쓰여 한쪽이 목록에서 사라진다
function uiSlug(text) {
    return String(text).replace(/[^A-Za-z0-9가-힣\u2160-\u217F]+/g, "_").replace(/^_+|_+$/g, "");
}

// 한 요소의 목록 항목 (지원하지 않는 종류는 null). orig는 덮어쓰기가 맞는 요소인지 확인하는 값
function uiDescribe(child, id, panelTitle, group) {
    var type = child.type, e = null, i;
    if (type === "panel") e = {text: child.text, orig: child.text};
    else if (type === "statictext" || type === "checkbox" || type === "radiobutton") {
        if (child.text) e = {text: child.text, orig: child.text};
    } else if (type === "button") {
        if (child.text && child.text !== "R") e = {text: child.text, orig: child.text};
    } else if (type === "scrollbar") {
        var label = "";
        for (i = 0; group && i < group.children.length; i++) {
            if (group.children[i] === child) break;
            if (group.children[i].type === "statictext" && group.children[i].text) label = group.children[i].text;
        }
        e = {label: label, min: child.minvalue, max: child.maxvalue, step: child.stepdelta, value: child.value,
            orig: child.minvalue + "|" + child.maxvalue + "|" + child.stepdelta};
    } else if (type === "dropdownlist") {
        var items = [];
        for (i = 0; i < child.items.length; i++) items.push(child.items[i].text);
        e = {items: items, orig: items.join("|")};
    }
    if (e === null) return null;
    e.id = id;
    e.type = type;
    e.panel = panelTitle;
    return e;
}

function uiCollect(container, path, panelTitle, list) {
    for (var i = 0; i < container.children.length; i++) {
        var child = container.children[i];
        var id = path ? path + "/" + i : String(i);
        var entry = uiDescribe(child, id, panelTitle, container);
        if (entry !== null) list.push(entry);
        if (child.children && child.children.length) uiCollect(child, id, child.type === "panel" ? child.text : panelTitle, list);
    }
}

// R 단추가 되돌리는 값을 덮어쓴다: 같은 줄의 입력창에 그 값을 치는 것과 같은 길로 간다
function uiOverrideReset(scrollbar, value) {
    var group = scrollbar.parent, input = null, reset = null, seen = false;
    for (var i = 0; i < group.children.length; i++) {
        var c = group.children[i];
        if (c === scrollbar) { seen = true; continue; }
        if (!seen && c.type === "edittext") input = c;
        if (seen && c.type === "button" && c.text === "R") { reset = c; break; }
    }
    if (reset === null || input === null) return;
    reset.onClick = function() {
        input.text = String(value);
        if (input.onChange) input.onChange();
        else if (input.onChanging) input.onChanging();
    };
}

function uiApplyOverrides(container, path, over) {
    for (var i = 0; i < container.children.length; i++) {
        var child = container.children[i];
        var id = path ? path + "/" + i : String(i);
        var o = over[id];
        if (o) {
            try {
                var now = uiDescribe(child, id, "", container);
                if (now !== null && now.orig === o.orig) {
                    if (o.text !== undefined && o.text !== null && now.text !== undefined) child.text = o.text;
                    if (child.type === "scrollbar") {
                        var lo = o.min !== undefined ? Number(o.min) : child.minvalue;
                        var hi = o.max !== undefined ? Number(o.max) : child.maxvalue;
                        if (isFinite(lo) && isFinite(hi) && lo < hi) {
                            child.minvalue = lo;
                            child.maxvalue = hi;
                            if (child.value < lo) child.value = lo;
                            if (child.value > hi) child.value = hi;
                        }
                        var st = Number(o.step);
                        if (o.step !== undefined && isFinite(st) && st > 0) { child.stepdelta = st; child.jumpdelta = st * 10; }
                        if (o.reset !== undefined && o.reset !== null && isFinite(Number(o.reset))) uiOverrideReset(child, Number(o.reset));
                    }
                    if (child.type === "dropdownlist" && o.items) {
                        (function(list, names) {
                            uiQuiet(list, function() {
                                for (var k = 0; k < list.items.length && k < names.length; k++) {
                                    if (names[k] !== null && names[k] !== "") list.items[k].text = names[k];
                                }
                            });
                        })(child, o.items);
                    }
                }
            } catch (e) {}
        }
        if (child.children && child.children.length) uiApplyOverrides(child, id, over);
    }
}

function uiCatalogAndOverrides(win) {
    if (!UI_HELPER_DIR || !win.text) return;
    var key = win.text;
    // 목록은 덮어쓰기를 적용하기 전의 원래 모습으로 남긴다 (덮어쓰기가 있어도 항상 갱신해서 옛 목록이 남지 않게 한다)
    var list = [];
    uiCollect(win, "", "", list);
    var text = '{"dialog":' + uiJson(key) + ',"controls":[\n' + (function() {
        var rows = [];
        for (var i = 0; i < list.length; i++) rows.push(uiJson(list[i]));
        return rows.join(",\n");
    })() + "\n]}\n";
    try {
        var dir = new Folder(UI_HELPER_DIR + "/ui_catalog");
        if (!dir.exists) dir.create();
        var file = new File(dir.fsName + "/" + uiSlug(key) + ".json");
        file.encoding = "UTF-8";
        var same = false;
        if (file.exists) {
            file.open("r");
            var old = file.read();
            file.close();
            same = (old === text);
        }
        if (!same) {
            file.open("w");
            file.write(text);
            file.close();
        }
    } catch (eCatalog) {}
    var overText = uiReadFile(UI_HELPER_DIR + "/ui_overrides.json");
    if (overText) {
        var all = eval("(" + overText + ")");
        if (all && all[key]) uiApplyOverrides(win, "", all[key]);
    }
}

// 컨트롤을 고치는 동안 스크립트의 이벤트 핸들러가 불리지 않게 잠시 뗀다 (핸들러가 미리보기를 그리다 멈추는 것을 막는다)
function uiQuiet(control, fn) {
    var h1 = null, h2 = null, h3 = null, sel = -1;
    try { h1 = control.onChange; h2 = control.onChanging; h3 = control.onClick; } catch (e0) {}
    try { if (control.type === "dropdownlist" && control.selection) sel = control.selection.index; } catch (e1) {}
    try { control.onChange = null; control.onChanging = null; } catch (e2) {}
    try { fn(); } finally {
        try { if (sel >= 0) control.selection = sel; } catch (e3) {}
        try { control.onChange = h1; control.onChanging = h2; } catch (e4) {}
    }
}

// ---- 줄 맞춤과 화살촉 이름 ----
var COMPACT_EDIT_WIDTH = 62;

// [라벨 | 입력창 | 스크롤바 (| R)] 줄을 창 전체에서 같은 칸 폭으로 맞춘다: 패널이 달라도 입력창·슬라이더·R 단추가 세로로 한 줄에 선다.
// 라벨 칸은 창 안의 모든 그런 줄 중 가장 긴 글자에 맞춘다.
function compactCollectRows(container, rows, offset) {
    for (var i = 0; i < container.children.length; i++) {
        var child = container.children[i];
        if (child.type === "group") {
            var k = child.children;
            // 줄 끝에 단추나 체크가 더 붙은 줄도 같은 줄로 본다
            // 첫 칸이 체크박스인 줄(켜고 끄는 숫자 행)도 같은 줄로 본다. 체크박스 글자의 "(단위):"도 툴팁으로 옮긴다
            if (k.length >= 3 && (k[0].type === "statictext" || k[0].type === "checkbox") && k[1].type === "edittext" && k[2].type === "scrollbar") {
                if (k[0].type === "checkbox") compactLabel(k[0]);
                rows.push({group: child, label: k[0], edit: k[1], offset: offset});
            }
        }
        if (child.children && child.children.length) {
            // 패널·탭 안에 들어갈수록 왼쪽 여백만큼 오른쪽으로 밀리므로 그 합을 센다
            var extra = 0;
            if (child.type === "panel" || child.type === "tab") {
                try { extra = child.margins[0] || 0; } catch (eM) { extra = 0; }
            }
            compactCollectRows(child, rows, offset + extra);
        }
    }
}

function compactAlignRows(win) {
    var rows = [], i, need = 0, editWidth = COMPACT_EDIT_WIDTH, maxOffset = 0;
    compactCollectRows(win, rows, 0);
    if (rows.length < 2) return;
    for (i = 0; i < rows.length; i++) {
        var w = rows[i].label.graphics.measureString(rows[i].label.text)[0] + (rows[i].label.type === "checkbox" ? COMPACT_CHECK_BOX : 0);
        if (w > need) need = w;
        if (rows[i].edit.preferredSize.width > editWidth) editWidth = rows[i].edit.preferredSize.width;
        if (rows[i].offset > maxOffset) maxOffset = rows[i].offset;
    }
    var width = Math.ceil(need) + 6;
    for (i = 0; i < rows.length; i++) {
        rows[i].label.preferredSize.width = width;
        rows[i].label.maximumSize.width = width;
        rows[i].edit.preferredSize.width = editWidth;
        rows[i].edit.maximumSize.width = editWidth;
        // 패널 밖(또는 얕은 곳)의 줄은 모자란 왼쪽 여백을 줄 자체의 여백으로 채워 패널 안 줄과 세로로 맞춘다
        var gap = maxOffset - rows[i].offset;
        if (gap > 0) {
            try {
                var m = rows[i].group.margins;
                rows[i].group.margins = [(m[0] || 0) + gap, m[1] || 0, m[2] || 0, m[3] || 0];
            } catch (eG) {}
        }
    }
}

// 화살촉 모양 드롭다운(삼각형·꺾쇠·제비꼬리·작살형)은 모든 대화상자에서 번호로 보인다: 1 작살형(평가원식) 2 제비꼬리 3 삼각형 4 꺾쇠.
// 항목 순서와 개수는 그대로이고 글자만 바꾼다.
function compactArrowheadNames(container) {
    for (var i = 0; i < container.children.length; i++) {
        var child = container.children[i];
        if (child.type === "dropdownlist" && child.items.length === 4) {
            var map = [], hit = 0, k;
            for (k = 0; k < 4; k++) {
                var t = child.items[k].text;
                if (/^작살형/.test(t)) { map.push("1"); hit++; }
                else if (/^제비꼬리/.test(t)) { map.push("2"); hit++; }
                else if (/^삼각형/.test(t)) { map.push("3"); hit++; }
                else if (/^꺾쇠/.test(t)) { map.push("4"); hit++; }
                else map.push(null);
            }
            if (hit === 4) {
                // 항목 글자를 바꾸면 ScriptUI가 onChange를 부를 수 있고, 스크립트의 핸들러가 미리보기를 다시 그리며 이 드롭다운을 다시 건드리면
                // 끝없이 돈다(2026-10-09 MotionPhoto에서 일러가 멈춤). 바꾸는 동안 핸들러를 떼고 선택을 그대로 복원한다
                var keepChange = child.onChange, keepIndex = child.selection ? child.selection.index : -1;
                child.onChange = null;
                for (k = 0; k < 4; k++) child.items[k].text = map[k];
                if (keepIndex >= 0) child.selection = keepIndex;
                child.onChange = keepChange;
                var legend = "1 작살형(평가원식)  2 제비꼬리  3 삼각형  4 꺾쇠";
                child.helpTip = child.helpTip ? child.helpTip + "\n" + legend : "화살촉 모양  " + legend;
            }
        }
        if (child.children && child.children.length) compactArrowheadNames(child);
    }
}
