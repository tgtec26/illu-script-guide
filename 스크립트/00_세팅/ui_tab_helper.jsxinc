// ui_tab_helper.jsxinc
// ScriptUI 탭 순서는 생성 순서라 `라벨(단위) | 입력창 | 스크롤바(‹ › 내장)` 행에서는 입력창 다음이
// 스크롤바로 간다. 창 안의 모든 입력창(edittext)을 생성 순서로 모아 탭(shift+탭)이
// 켜진 입력창끼리만 오가게 한다. 마지막에서는 처음으로 돌아간다.
// 사용: 창을 다 만든 뒤 win.show() 전에 bindTabOrder(win). 각 스크립트는 이 파일을
// $.evalFile로 읽고 typeof로 확인하므로, 파일이 없어도 스크립트는 그대로 동작한다.
function bindTabOrder(win) {
    compactDialog(win);
    var inputs = [];
    collectEditTexts(win, inputs);
    for (var k = 0; k < inputs.length; k++) {
        inputs[k].addEventListener("keydown", makeTabOrderHandler(win, inputs, k));
    }
}

function collectEditTexts(container, inputs) {
    var children = container.children;
    if (!children) return;
    for (var i = 0; i < children.length; i++) {
        var child = children[i];
        if (child.type === "edittext") inputs.push(child);
        else collectEditTexts(child, inputs);
    }
}

function makeTabOrderHandler(win, inputs, index) {
    return function(event) {
        if (event.keyName !== "Tab") return;
        var step = event.shiftKey ? -1 : 1;
        var count = inputs.length;
        for (var n = 1; n < count; n++) {
            var next = inputs[((index + step * n) % count + count) % count];
            if (!isTabTarget(win, next)) continue;
            next.active = true;
            try { event.preventDefault(); } catch (e) {}
            return;
        }
    };
}

// 자신이나 조상(패널·그룹)이 꺼져 있거나 숨겨진 입력창은 건너뛴다
function isTabTarget(win, control) {
    for (var c = control; c && c !== win; c = c.parent) {
        if (!c.enabled || !c.visible) return false;
    }
    return true;
}

// ---- 대화상자 다이어트 (bindTabOrder가 창을 띄우기 직전에 부른다) ----
// 스크립트마다 손대지 않고 한 곳에서 줄인다. 줄이기만 하고 늘리지는 않는다.
//  - 창·패널 여백, 그룹 간격
//  - 스크롤바 폭 118 이하 (R 버튼은 그대로)
//  - 라벨의 "(단위)"·콜론 제거 (단위는 마우스를 올리면 툴팁으로), 라벨 칸을 글자 폭에 맞춤
//  - 확인·취소 버튼 폭 고정, 버튼만 있는 줄은 오른쪽 정렬
// 검증용으로 $.global.__noCompact = true면 건너뛴다. 실패해도 대화상자는 그대로 뜬다.
var COMPACT_SLIDER_WIDTH = 118;
var COMPACT_BUTTON_WIDTH = 64;
var COMPACT_BUTTON_PAD = 14;   // 글자 좌우 여백 합 (2026-10-09: 28 → 14로 절반)
var COMPACT_ROW_HEIGHT = 22;
var COMPACT_UNIT = /^(mm|cm|m|pt|px|%|°|deg|s|ms|배|개|회|번|도|단계|줄|칸|N|J|g|kg|K|℃|°C|m\/s|m\/s²)$/;
var COMPACT_BUTTONS = {"확인": true, "취소": true, "OK": true, "Cancel": true, "적용": true, "닫기": true};

function compactDialog(win) {
    try {
        if ($.global.__noCompact) return;
        try {
            var wm = win.margins;
            win.margins = [Math.min(wm[0], 8), Math.min(wm[1], 8), Math.min(wm[2], 8), Math.min(wm[3], 8)];
            if (win.spacing > 3) win.spacing = 3;
        } catch (e0) {}
        compactWalk(win);
        compactButtons(win);
    } catch (e) {}
}

function compactWalk(container) {
    var children = container.children;
    if (!children) return;
    var i, child;
    for (i = 0; i < children.length; i++) {
        child = children[i];
        try {
            if (child.type === "panel") {
                compactPanelTitle(child);
                var m = child.margins;
                child.margins = [Math.min(m[0], 8), Math.max(12, Math.min(m[1], 14)), Math.min(m[2], 8), Math.min(m[3], 3)];
                if (child.spacing > 1) child.spacing = 1;
            } else if (child.type === "group") {
                var limit = child.orientation === "row" ? 6 : 1;
                if (child.spacing > limit) child.spacing = limit;
            } else if (child.type === "scrollbar") {
                // 이미 레이아웃이 잡힌 창은 preferredSize만으로는 줄지 않아 maximumSize도 건다
                if (child.preferredSize.width > COMPACT_SLIDER_WIDTH) {
                    child.preferredSize.width = COMPACT_SLIDER_WIDTH;
                    child.maximumSize.width = COMPACT_SLIDER_WIDTH;
                }
            } else if (child.type === "statictext") {
                compactLabel(child);
            } else if (child.type === "edittext") {
                // 한 줄짜리 입력창은 기본 높이가 커서 행이 높아진다
                if (!child.properties || !child.properties.multiline) { child.preferredSize.height = COMPACT_ROW_HEIGHT; child.maximumSize.height = COMPACT_ROW_HEIGHT; }
            } else if (child.type === "dropdownlist") {
                child.preferredSize.height = COMPACT_ROW_HEIGHT;
                child.maximumSize.height = COMPACT_ROW_HEIGHT;
            } else if (child.type === "button" && child.text === "R") {
                child.preferredSize.height = COMPACT_ROW_HEIGHT;
                child.maximumSize.height = COMPACT_ROW_HEIGHT;
            } else if (child.type === "button" && COMPACT_BUTTONS[child.text]) {
                child.preferredSize.width = COMPACT_BUTTON_WIDTH;
                child.maximumSize.width = COMPACT_BUTTON_WIDTH;
            }
        } catch (e1) {}
        if (child.children && child.children.length) compactWalk(child);
    }
    try { compactLabelWidths(container); } catch (e2) {}
    try { compactButtonRow(container); } catch (e3) {}
}

// "크기 (mm):" → "크기" (단위는 툴팁), "각도:" → "각도". 긴 안내문은 건드리지 않는다
function compactLabel(label) {
    var text = label.text;
    if (!text || text.length > 30) return;
    var unit = text.match(/^(.*\S)\s*\(([^)]+)\)\s*[:：]?\s*$/);
    if (unit && COMPACT_UNIT.test(unit[2])) {
        label.text = unit[1];
        if (!label.helpTip) label.helpTip = unit[2];
        return;
    }
    var colon = text.match(/^(.*\S)\s*[:：]\s*$/);
    if (colon) label.text = colon[1];
}

// 같은 컨테이너의 행(그룹)마다 첫 라벨 폭을 가장 긴 글자에 맞춰 줄인다 (원래 폭보다 늘리지는 않는다)
function compactLabelWidths(container) {
    var rows = [], i, need = 0;
    for (i = 0; i < container.children.length; i++) {
        var g = container.children[i];
        if (g.type !== "group" || g.children.length < 2) continue;
        var first = g.children[0];
        if (first.type !== "statictext" || !(first.preferredSize.width > 0)) continue;
        rows.push(first);
        var w = first.graphics.measureString(first.text)[0];
        if (w > need) need = w;
    }
    var width = Math.ceil(need) + 6;
    for (i = 0; i < rows.length; i++) {
        if (width < rows[i].preferredSize.width) {
            rows[i].preferredSize.width = width;
            rows[i].maximumSize.width = width;
        }
    }
}

// 확인·취소만 있는 줄은 오른쪽에 붙인다 (다른 컨트롤이 같이 있으면 정렬은 그대로)
function compactButtonRow(container) {
    if (container.type !== "group") return;
    var any = false, i;
    for (i = 0; i < container.children.length; i++) {
        var c = container.children[i];
        if (c.type === "button" && COMPACT_BUTTONS[c.text]) any = true;
        else if (!(c.type === "group" && c.children.length === 0)) return;
    }
    if (any) container.alignment = ["right", "center"];
}

// 패널 제목이 길면 첫 문장만 남기고 나머지는 툴팁으로 ("관찰 각도 방식. 선택 없이…" → "관찰 각도 방식")
function compactPanelTitle(panel) {
    var text = panel.text;
    if (!text || text.length <= 12) return;
    var cut = text.search(/\. |\s—\s|\s\(/);
    if (cut < 2) return;
    if (!panel.helpTip) panel.helpTip = text;
    panel.text = text.substr(0, cut);
}

// 글자보다 훨씬 넓게 지정된 버튼(프리셋 줄 등)을 글자 폭에 맞춘다. 폭이 따로 지정된 버튼 중 글자 폭 + 12보다 넓은 것만 줄이고,
// 한 줄(그룹)의 버튼은 가장 긴 글자에 맞춰 같은 폭으로 한다 (R 버튼·격자처럼 원래 좁은 버튼은 그대로).
// 주의: 여기서 layout()을 부르면 안 된다. 한 번 레이아웃이 잡히면 ScriptUI가 늘어난 크기를 preferredSize로 굳혀 이후에 줄여도 창이 줄지 않는다.
function compactButtons(win) {
    compactButtonWalk(win);
}

function compactButtonWalk(container) {
    var i, k, group = [], need = 0, wide = false;
    for (i = 0; i < container.children.length; i++) {
        k = container.children[i];
        if (k.type === "button" && k.text && k.text !== "R" && !COMPACT_BUTTONS[k.text]) {
            var w = k.graphics.measureString(k.text)[0] + COMPACT_BUTTON_PAD;
            group.push(k);
            if (w > need) need = w;
            if (k.preferredSize.width > w + 12) wide = true;
        }
        if (k.children && k.children.length) compactButtonWalk(k);
    }
    if (!wide) return;
    for (i = 0; i < group.length; i++) {
        if (group[i].preferredSize.width > need) {
            group[i].preferredSize.width = Math.ceil(need);
            group[i].maximumSize.width = Math.ceil(need);
        }
    }
}

// ---- 접는 패널 ----
// 행이 많은 패널을 접어 창 높이를 줄인다. 패널 맨 위에 [접기/펼치기] 단추가 있고, 행은 돌려받은 body 그룹에 넣는다
// (parent.add("panel") 대신 body = makeCollapsiblePanel(parent, "제목", true, "스크립트/패널") 으로 만들고 body.add(...)).
// 접힌 상태는 app.preferences "<key>"(1 = 접힘)에 기억한다. 헬퍼가 없는 환경에서는 일반 패널로 대신해도 된다:
//   var body = typeof makeCollapsiblePanel === "function" ? makeCollapsiblePanel(...) : parent.add("panel", undefined, "제목");
// 숨기는 건 visible이 아니라 maximumSize.height = 0이다 (visible=false는 공간을 비우지 않는다).
function makeCollapsiblePanel(parent, title, collapsedDefault, key) {
    var collapsed = collapsedDefault;
    try {
        var saved = app.preferences.getStringPreference("Fold/" + key);
        if (saved === "1") collapsed = true;
        else if (saved === "0") collapsed = false;
    } catch (e0) {}
    var panel = parent.add("panel", undefined, title);
    panel.orientation = "column";
    panel.alignChildren = "fill";
    var head = panel.add("group");
    head.alignChildren = ["left", "center"];
    var toggle = head.add("button", undefined, "");
    toggle.preferredSize.width = 60;
    toggle.preferredSize.height = 20;
    var body = panel.add("group");
    body.orientation = "column";
    body.alignChildren = "fill";
    function apply() {
        toggle.text = collapsed ? "펼치기" : "접기";
        toggle.helpTip = collapsed ? "이 패널의 항목을 펼칩니다" : "이 패널의 항목을 접습니다";
        body.visible = !collapsed;
        body.maximumSize.height = collapsed ? 0 : 10000;
    }
    apply();
    toggle.onClick = function() {
        collapsed = !collapsed;
        apply();
        try { app.preferences.setStringPreference("Fold/" + key, collapsed ? "1" : "0"); } catch (e1) {}
        try {
            var win = panel.window;
            // 줄일 때는 창을 작게 만든 뒤 다시 잡아야 줄어든다
            win.size = [10, 10];
            win.layout.layout(true);
        } catch (e2) {}
    };
    body.panel = panel;
    return body;
}
