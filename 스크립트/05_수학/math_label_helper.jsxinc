// 수학 묶음 공용: 미리보기 라벨을 그린 직후 겹침을 푼다. 각 탭의 그리기 코드는 건드리지 않는다.
// 스크립트 머리에서 $.evalFile로 읽고, 라벨 루프 뒤에서 untangleLabels(previewGroup, drawing)을 부른다.
// 파일이 없으면 부르는 쪽이 typeof로 건너뛰므로 라벨이 원래 자리에 남을 뿐이다.
//
// 1) 같은 자리에 같은 숫자가 두 번이면 앞의 눈금 숫자를 지운다 (y축에 "2 2"처럼 두 번 나오지 않게)
// 2) 다른 라벨·선과 겹치는 라벨은 기준점(at) 둘레 16방향 중 덜 겹치는 쪽으로 옮긴다 (간격은 원래대로, 없으면 한 칸 더 멀리)
// 3) 그래도 다른 라벨과 겹치는 눈금 숫자는 지운다 (점 이름·좌표가 눈금보다 중요하다)
// 축 이름(x, y, O 등)과 눈금 숫자는 옮기지 않는다. 라벨 수와 글상자 수가 다르면 아무것도 하지 않는다.
// 쌓은 분수 라벨: 글에 \frac{분자}{분모} 또는 frac(분자,분모)가 있으면 분자·분모를 위아래로 쌓고 가운데에 막대를 긋는다.
// 각 탭의 addLabel이 hasFractionText(label.text)면 buildStackedLabel로 그리고 label.item에 그룹을 달아, 겹침 풀기가 한 덩어리로 다룬다.
var FRACTION_GROUP_NAME = "분수 라벨";

function hasFractionText(text) {
    return typeof text === "string" && (text.indexOf("\\frac{") >= 0 || text.indexOf("frac(") >= 0);
}

function matchCloseChar(s, open, openCh, closeCh) {
    var depth = 0;
    for (var i = open; i < s.length; i++) {
        if (s.charAt(i) === openCh) depth++;
        else if (s.charAt(i) === closeCh) { depth--; if (depth === 0) return i; }
    }
    return -1;
}

// 글 → [{text}] 또는 [{num, den}] 조각 목록. 모양이 틀린 분수는 글자 그대로 둔다
function splitFractionText(s) {
    var parts = [], plain = "";
    function flush() { if (plain !== "") { parts.push({text: plain}); plain = ""; } }
    var i = 0;
    while (i < s.length) {
        var end = -1, num = "", den = "";
        if (s.substr(i, 6) === "\\frac{") {
            var a = matchCloseChar(s, i + 5, "{", "}");
            if (a > 0 && s.charAt(a + 1) === "{") {
                var b = matchCloseChar(s, a + 1, "{", "}");
                if (b > 0) { num = s.substring(i + 6, a); den = s.substring(a + 2, b); end = b; }
            }
        } else if (s.substr(i, 5) === "frac(") {
            var c = matchCloseChar(s, i + 4, "(", ")");
            if (c > 0) {
                var depth = 0, comma = -1;
                for (var k = i + 5; k < c; k++) {
                    var ch = s.charAt(k);
                    if (ch === "(") depth++;
                    else if (ch === ")") depth--;
                    else if (ch === "," && depth === 0) { comma = k; break; }
                }
                if (comma > 0) { num = s.substring(i + 5, comma).replace(/^\s+|\s+$/g, ""); den = s.substring(comma + 1, c).replace(/^\s+|\s+$/g, ""); end = c; }
            }
        }
        if (end >= 0) { flush(); parts.push({num: num, den: den}); i = end + 1; }
        else { plain += s.charAt(i); i++; }
    }
    flush();
    return parts;
}

// 쌓은 분수가 든 라벨을 group 안에 그린다. makeFrame(group, 글, 크기pt, upright) → 서체를 입힌 글상자, makeBar(group, x0, x1, y) → 막대 선.
// 라벨 가운데가 at에서 dir 쪽으로 gapPt(+clear) 떨어지게 놓고 그룹을 돌려준다. 좌표는 일러 좌표(y 위쪽 양수)
function buildStackedLabel(group, label, fontPt, gapPt, makeFrame, makeBar) {
    var inner = group.groupItems.add();
    inner.name = FRACTION_GROUP_NAME;
    var parts = splitFractionText(label.text);
    var partSize = fontPt * 0.85, barGap = fontPt * 0.2, x = 0, i;
    // 세로 위치는 글상자 크기(서체마다 다르다)가 아니라 기준선(anchor)으로 맞춘다. 막대는 y=0, 본문 기준선은 막대 아래 0.3em
    var baselineY = -0.3 * fontPt;
    for (i = 0; i < parts.length; i++) {
        var part = parts[i], b;
        if (part.text !== undefined) {
            var frame = makeFrame(inner, part.text, fontPt, label.upright);
            b = frame.geometricBounds;
            frame.translate(x - b[0], baselineY - frame.anchor[1]);
            x += b[2] - b[0];
        } else {
            var numFrame = makeFrame(inner, part.num, partSize, true), denFrame = makeFrame(inner, part.den, partSize, true);
            var nb = numFrame.geometricBounds, db = denFrame.geometricBounds;
            var width = Math.max(nb[2] - nb[0], db[2] - db[0]) + fontPt * 0.24;
            numFrame.translate(x + (width - (nb[2] - nb[0])) / 2 - nb[0], barGap - numFrame.anchor[1]);
            denFrame.translate(x + (width - (db[2] - db[0])) / 2 - db[0], -barGap - 0.72 * partSize - denFrame.anchor[1]);
            makeBar(inner, x + fontPt * 0.04, x + width - fontPt * 0.04, 0);
            x += width;
        }
    }
    var gb = inner.geometricBounds;
    var halfW = (gb[2] - gb[0]) / 2, halfH = (gb[1] - gb[3]) / 2;
    var dir = label.dir || [0, 0];
    var centered = dir[0] === 0 && dir[1] === 0;
    var reach = centered ? 0 : (label.clear || 0) + gapPt + halfW * Math.abs(dir[0]) + halfH * Math.abs(dir[1]);
    inner.translate(label.at[0] + dir[0] * reach - (gb[0] + gb[2]) / 2, label.at[1] + dir[1] * reach - (gb[1] + gb[3]) / 2);
    label.item = inner;
    return inner;
}

function untangleLabels(group, drawing) {
    try { untangleLabelsCore(group, drawing); } catch (e) {}
}

function untangleLabelsCore(group, drawing) {
    var texts = drawing.texts;
    var n = texts ? texts.length : 0;
    if (n === 0) return;
    // 글자 하나짜리 라벨은 그룹 바로 아래 글상자, 여러 조각 라벨은 addLabel이 묶어 label.item에 단 그룹이다
    var plain = [];
    for (var t = 0; t < n; t++) if (!texts[t].item) plain.push(t);
    // 쌓은 분수 라벨은 "분수 라벨" 그룹 안에 글상자 여러 개가 들어 있으니 센 글상자에서 뺀다
    var allFrames = group.textFrames;
    var frames = [];
    for (var fi = 0; fi < allFrames.length; fi++) {
        var parentItem = null;
        try { parentItem = allFrames[fi].parent; } catch (parentError) {}
        if (!(parentItem && parentItem.name === FRACTION_GROUP_NAME)) frames.push(allFrames[fi]);
    }
    if (frames.length !== plain.length) return;

    // 글상자는 나중에 만든 것이 앞(0번)이다
    var items = [];
    var frameOf = {};
    for (var k = 0; k < plain.length; k++) frameOf[plain[k]] = frames[plain.length - 1 - k];
    for (t = 0; t < n; t++) {
        var label = texts[t];
        var frame = label.item || frameOf[t];
        if (!label.item && typeof label.text === "string" && frame.contents.length !== label.text.length) return;
        var b = frame.geometricBounds;
        items.push({ label: label, frame: frame, box: [b[0], b[1], b[2], b[3]], role: labelRole(label), gone: false });
    }

    var segments = collectSegments(drawing.lines);

    // 1) 같은 자리에 같은 글자가 두 번이면 (눈금 숫자와 점 좌표) 앞의 눈금 숫자를 지운다
    for (var i = 0; i < n; i++) {
        if (items[i].role !== "tick") continue;
        for (var j = i + 1; j < n; j++) {
            if (items[j].gone || typeof items[j].label.text !== "string") continue;
            if (items[j].label.text === items[i].label.text && samePoint(items[j].label.at, items[i].label.at)) {
                removeItem(items[i]);
                break;
            }
        }
    }

    // 2) 겹치는 점 라벨을 옮긴다
    for (i = 0; i < n; i++) {
        var item = items[i];
        if (item.gone || item.role !== "point" || !item.label.at || !item.label.dir) continue;
        var cost = labelCost(item, item.box, items, segments);
        if (cost === 0) continue;
        var best = findBetterPlace(item, cost, items, segments);
        if (best === null) continue;
        item.frame.translate(best[0] - item.box[0], best[1] - item.box[1]);
        item.box = best;
    }

    // 3) 남은 겹침: 다른 라벨(점 이름·구간 끝 a, b 등)과 겹치는 눈금 숫자를 지운다
    for (i = 0; i < n; i++) {
        if (items[i].gone || items[i].role !== "tick") continue;
        for (j = 0; j < n; j++) {
            if (items[j].gone || items[j].role === "tick" || items[j].role === "name") continue;
            if (boxesOverlap(items[i].box, items[j].box, 0)) { removeItem(items[i]); break; }
        }
    }
}

// tick: 축 위의 눈금 숫자, name: 축 이름·원점 O, fixed: 각 라벨처럼 제자리여야 하는 라벨, point: 그 밖의 라벨 (옮길 수 있다)
function labelRole(label) {
    var text = typeof label.text === "string" ? label.text : null;
    var at = label.at, dir = label.dir;
    var onAxis = at && (Math.abs(at[0]) < 0.01 || Math.abs(at[1]) < 0.01);
    if (text === "O" && at && Math.abs(at[0]) < 0.01 && Math.abs(at[1]) < 0.01) return "name";   // 원점 O (외심 O 등은 점 라벨)
    // 수직선처럼 dir이 숫자인 라벨은 눈금으로 보고 두지 않는다
    if (typeof dir === "number") return label.clear !== undefined ? "tick" : "fixed";
    if (!dir || (Math.abs(dir[0]) < 1e-6 && Math.abs(dir[1]) < 1e-6)) return "fixed";
    var axisDir = (Math.abs(dir[0]) < 0.01 && Math.abs(dir[1]) > 0.99) || (Math.abs(dir[1]) < 0.01 && Math.abs(dir[0]) > 0.99);
    if (text !== null && label.clear !== undefined && onAxis && axisDir &&
        /^[\-\u2212]?[0-9.]*\u03C0?(\/[0-9]+)?$/.test(text) && text !== "") return "tick";
    if (text !== null && label.clear === undefined && !label.upright && onAxis && axisDir && text.length <= 3 && !/[0-9]/.test(text)) return "name";
    // 각의 θ·각도처럼 호(clear)에 맞춰 놓은 라벨, 그리스 문자 한 글자(각 이름)는 자리를 옮기면 뜻이 바뀐다
    if (label.clear !== undefined && label.clear > 0) return "fixed";
    if (text !== null && /^[\u0391-\u03C9]$/.test(text)) return "fixed";
    return "point";
}

function samePoint(a, b) {
    return a && b && Math.abs(a[0] - b[0]) < 0.5 && Math.abs(a[1] - b[1]) < 0.5;
}

function removeItem(item) {
    item.frame.remove();
    item.gone = true;
}

// 겹침 점수: 다른 라벨(4), 실선(2), 눈금 숫자(1), 점선 보조선(0.5). 눈금은 나중에 지울 수 있고 점선은 걸쳐도 읽혀 가볍게 친다
function labelCost(item, box, items, segments) {
    var cost = 0;
    for (var i = 0; i < items.length; i++) {
        var other = items[i];
        if (other === item || other.gone) continue;
        if (boxesOverlap(box, other.box, -0.5)) cost += other.role === "tick" ? 1 : 4;
    }
    var padded = [box[0] - 0.3, box[1] + 0.3, box[2] + 0.3, box[3] - 0.3];   // 선에 딱 붙은 자리도 겹침으로 친다
    for (var s = 0; s < segments.length; s++) {
        if (segmentHitsBox(segments[s], padded)) cost += segments[s][8];
    }
    return cost;
}

// 원래 방향과 가까운 쪽부터 16방향을 본다. 간격(글자 가장자리와 at 사이)은 원래 배치에서 잰다.
// 그 간격에서 실선·라벨을 피할 수 없으면 반 칸, 한 칸(글자 높이) 더 떨어진 고리도 본다 (가까운 고리를 먼저 쓴다)
function findBetterPlace(item, cost, items, segments) {
    var box = item.box, at = item.label.at, dir = item.label.dir;
    var halfW = (box[2] - box[0]) / 2, halfH = (box[1] - box[3]) / 2;
    var cx = (box[0] + box[2]) / 2, cy = (box[1] + box[3]) / 2;
    var length = Math.sqrt(dir[0] * dir[0] + dir[1] * dir[1]) || 1;
    var ux = dir[0] / length, uy = dir[1] / length;
    var gap = (cx - at[0]) * ux + (cy - at[1]) * uy - (halfW * Math.abs(ux) + halfH * Math.abs(uy));
    if (!(gap > 0)) gap = 1;
    var start = Math.atan2(uy, ux);
    var best = null, bestCost = cost;
    var gaps = [gap, gap + Math.min(halfH, 5), gap + Math.min(halfH * 2, 10)];   // 프라임(′) 든 글상자는 실제 글자보다 훨씬 높아 폭을 제한한다
    for (var g = 0; g < gaps.length && bestCost > 0; g++) {
        if (g > 0 && bestCost < 2) break;   // 가까운 자리에서 점선에만 걸치면 멀리 가지 않는다
        for (var k = g === 0 ? 1 : 0; k < 16; k++) {
            var step = Math.ceil(k / 2) * (k % 2 === 1 ? 1 : -1);   // 0, +1, -1, +2, -2 … 원래 방향에서 가까운 순
            var angle = start + step * Math.PI / 8;
            var dx = Math.cos(angle), dy = Math.sin(angle);
            var reach = gaps[g] + halfW * Math.abs(dx) + halfH * Math.abs(dy);
            var x = at[0] + dx * reach, y = at[1] + dy * reach;
            var candidate = [x - halfW, y + halfH, x + halfW, y - halfH];
            // 먼 고리는 아무것도 걸리지 않는 자리만 쓴다 (점에서 멀어지는 만큼 확실해야 한다)
            var candidateCost = labelCost(item, candidate, items, segments);
            if (g > 0 && candidateCost > 0) continue;
            if (candidateCost < bestCost) { best = candidate; bestCost = candidateCost; }
            if (bestCost === 0) break;
        }
    }
    return best;
}

// 상자는 [왼, 위, 오른, 아래] (일러 좌표, 위가 큰 값). margin이 음수면 그만큼 떨어져 있어야 안 겹친 것으로 본다
function boxesOverlap(a, b, margin) {
    return a[0] < b[2] - margin && b[0] < a[2] - margin && a[3] < b[1] - margin && b[3] < a[1] - margin;
}

// 선을 짧은 선분으로 편다. 곡선 구간은 여섯 조각으로 나눈다. 격자는 뺀다
function collectSegments(lines) {
    var segments = [];
    if (!lines) return segments;
    for (var i = 0; i < lines.length; i++) {
        var line = lines[i];
        if (!line || line.kind === "grid") continue;
        var points = line.points || line;
        if (!points || !points.length) continue;
        var closed = line.closed === true;
        var weight = line.dashed === true || line.kind === "guide" || line.kind === "dashed" || line.kind === "trace" ? 0.5 : 2;
        var count = closed ? points.length : points.length - 1;
        for (var p = 0; p < count; p++) {
            var a = points[p], b = points[(p + 1) % points.length];
            var a0 = anchorOf(a), b0 = anchorOf(b);
            if (!a0 || !b0) continue;
            var a1 = a.right || a0, b1 = b.left || b0;
            var curved = a1[0] !== a0[0] || a1[1] !== a0[1] || b1[0] !== b0[0] || b1[1] !== b0[1];
            if (!curved) { pushSegment(segments, a0, b0, weight); continue; }
            var previous = a0;
            for (var s = 1; s <= 6; s++) {
                var u = s / 6, v = 1 - u;
                var next = [v * v * v * a0[0] + 3 * v * v * u * a1[0] + 3 * v * u * u * b1[0] + u * u * u * b0[0],
                            v * v * v * a0[1] + 3 * v * v * u * a1[1] + 3 * v * u * u * b1[1] + u * u * u * b0[1]];
                pushSegment(segments, previous, next, weight);
                previous = next;
            }
        }
    }
    return segments;
}

function anchorOf(point) {
    if (!point) return null;
    if (point.anchor) return point.anchor;
    if (typeof point[0] === "number") return point;
    return null;
}

function pushSegment(segments, a, b, weight) {
    segments.push([a[0], a[1], b[0], b[1],
        Math.min(a[0], b[0]), Math.max(a[0], b[0]), Math.min(a[1], b[1]), Math.max(a[1], b[1]), weight || 2]);
}

// 선분이 상자를 지나는지 (Liang-Barsky 자르기)
function segmentHitsBox(seg, box) {
    if (seg[5] < box[0] || seg[4] > box[2] || seg[7] < box[3] || seg[6] > box[1]) return false;
    var x0 = seg[0], y0 = seg[1], dx = seg[2] - x0, dy = seg[3] - y0;
    var t0 = 0, t1 = 1;
    var p = [-dx, dx, -dy, dy], q = [x0 - box[0], box[2] - x0, y0 - box[3], box[1] - y0];
    for (var i = 0; i < 4; i++) {
        if (p[i] === 0) { if (q[i] < 0) return false; continue; }
        var r = q[i] / p[i];
        if (p[i] < 0) { if (r > t1) return false; if (r > t0) t0 = r; }
        else { if (r < t0) return false; if (r < t1) t1 = r; }
    }
    return true;
}
